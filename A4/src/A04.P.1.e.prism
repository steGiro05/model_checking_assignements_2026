dtmc

module client1
  state1 : [0..1] init 0; // State of the job (inactive/active)
  task1  : [0..5] init 0; // Length of the job
  
  // Create a new job - length chose non-deterministically
  [create1] state1=0 ->
      1/5 : (state1'=1) & (task1'=1)
    + 1/5 : (state1'=1) & (task1'=2)
    + 1/5 : (state1'=1) & (task1'=3)
    + 1/5 : (state1'=1) & (task1'=4)
    + 1/5 : (state1'=1) & (task1'=5);

  // Serve the job
  [serve1] state1=1 & task1>0 -> (task1'=task1-1);

  // Complete the job
  [finish1] state1=1 & task1=0 -> (state1'=0);

endmodule

module client2 = client1 [state1=state2,
                          task1=task2,
                          create1=create2,
                          serve1=serve2,
                          finish1=finish2 ]
endmodule

module client3 = client1 [state1=state3,
                          task1=task3,
                          create1=create3,
                          serve1=serve3,
                          finish1=finish3 ]
endmodule

module scheduler
  tickets1 : [0..1] init 0; // Number of tickets for client1
  tickets2 : [0..1] init 0; // Number of tickets for client2
  tickets3 : [0..1] init 0; // Number of tickets for client3

  serving : [0..3] init 0;

  // Assign tickets randomly on job creation
  [create1] tickets1 = 0 & serving=0 -> 1: (tickets1'=1);
  [create2] tickets2 = 0 & serving=0 -> 1: (tickets2'=1);
  [create3] tickets3 = 0 & serving=0 -> 1: (tickets3'=1);

  // Serve the job, uniform distribution since each job has 1 ticket
  [serve1] tickets1 > 0 & tickets1 >= tickets2 & tickets1 >= tickets3 & serving=0 -> (serving'=1);
  [serve2] tickets2 > 0 & tickets2 >= tickets1 & tickets2 >= tickets3 & serving=0 -> (serving'=2);
  [serve3] tickets3 > 0 & tickets3 >= tickets2 & tickets3 >= tickets1 & serving=0 -> (serving'=3);

  //Serve for the second tick a job
  [serve1] serving=1 -> (serving'=0);
  [serve2] serving=2 -> (serving'=0);
  [serve3] serving=3 -> (serving'=0);

   // Complete the job that has finished
  [finish1] tickets1 > 0 -> (tickets1'=0) & (serving'=0);
  [finish2] tickets2 > 0 -> (tickets2'=0) & (serving'=0);
  [finish3] tickets3 > 0 -> (tickets3'=0) & (serving'=0);

endmodule

module monitor
  finished: bool init false;
	
  //monitor finish1 actions
  [finish1] finished = false -> (finished' = true);
  [finish1] finished = true -> true;

endmodule

system
  scheduler || client1 || client2 || client3 || monitor
endsystem

