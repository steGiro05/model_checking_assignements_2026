  [elect_b_6] (selected_6 = 2 & finished_6 = false) -> (finished_6' = true);
  [elect_c_6] (selected_6 = 3 & finished_6 = false) -> (finished_6' = true);
endmodule

// overall voting system
// the chosen pact has a majority of the seats
formula pact_majority = (allegiances=1 & count_a + count_b >= MAJ) | (allegiances=2 & count_a + count_c >= MAJ) | (allegiances=3 & count_b + count_c >= MAJ);

const int N = 6;             // number of constituencies
const int MAJ = 4;    // majority -- cannot use division for parsing problems, tune manually
module voting_system
  count_a : [0..N] init 0; //overall votes for party a
  count_b : [0..N] init 0; //overall votes for party b
  count_c : [0..N] init 0; //overall votes for party c
  winner : [0..7] init 0; // final winner: 1,2,3 -> a,b,c alone; 4,5,6 -> pacts ab,ac,bc; 7 -> hung parliament

  // monitors for elections in costituencies
  [elect_a_1] count_a < N -> (count_a' = count_a + 1);
  [elect_b_1] count_b < N -> (count_b' = count_b + 1);
  [elect_c_1] count_c < N -> (count_c' = count_c + 1);

  [elect_a_2] count_a < N -> (count_a' = count_a + 1);
  [elect_b_2] count_b < N -> (count_b' = count_b + 1);
  [elect_c_2] count_c < N -> (count_c' = count_c + 1);

  [elect_a_3] count_a < N -> (count_a' = count_a + 1);
  [elect_b_3] count_b < N -> (count_b' = count_b + 1);
  [elect_c_3] count_c < N -> (count_c' = count_c + 1);

  [elect_a_4] count_a < N -> (count_a' = count_a + 1);
  [elect_b_4] count_b < N -> (count_b' = count_b + 1);
  [elect_c_4] count_c < N -> (count_c' = count_c + 1);

  [elect_a_5] count_a < N -> (count_a' = count_a + 1);
  [elect_b_5] count_b < N -> (count_b' = count_b + 1);
  [elect_c_5] count_c < N -> (count_c' = count_c + 1);

  [elect_a_6] count_a < N -> (count_a' = count_a + 1);
  [elect_b_6] count_b < N -> (count_b' = count_b + 1);
  [elect_c_6] count_c < N -> (count_c' = count_c + 1);

  //when all votes are recorded establish a winner
  [win_a] (winner=0 & count_a + count_b + count_c = N & count_a >= MAJ) -> (winner'=1);
  [win_b] (winner=0 & count_a + count_b + count_c = N & count_b >= MAJ) -> (winner'=2);
  [win_c] (winner=0 & count_a + count_b + count_c = N & count_c >= MAJ) -> (winner'=3);

  // no single-party majority: the pact governs if its partners together reach the majority
  [win_ab] (winner=0 & count_a + count_b + count_c = N & count_a < MAJ & count_b < MAJ & allegiances=1 & count_a + count_b >= MAJ) -> (winner'=4);
  [win_ac] (winner=0 & count_a + count_b + count_c = N & count_a < MAJ & count_c < MAJ & allegiances=2 & count_a + count_c >= MAJ) -> (winner'=5);
  [win_bc] (winner=0 & count_a + count_b + count_c = N & count_b < MAJ & count_c < MAJ & allegiances=3 & count_b + count_c >= MAJ) -> (winner'=6);
  [hang] (winner=0 & count_a + count_b + count_c = N & count_a < MAJ & count_b < MAJ & count_c < MAJ & !pact_majority) -> (winner'=7);

  // final states: once a winner is established the system stays there forever
  [end] winner != 0 -> true;
endmodule

// imposes a fixed order: constituency i votes only after constituency i-1 has been counted,
// removing the interleaving between constituencies (results unchanged, far fewer states)
module order_monitor
  turn : [0..N+1] init 0; // constituency allowed to act - N+1 means all constituencies done
  allegiances : [0..3] init 0; //what allegiance has been formed 0->none, 1->ab, 2->ac, 3->bc

  //non-deterministic allegiances before voting
  [allegiance] turn = 0 -> (turn' = 1) & (allegiances' = 0);
  [allegiance] turn = 0 -> (turn' = 1) & (allegiances' = 1);
  [allegiance] turn = 0 -> (turn' = 1) & (allegiances' = 2);
  [allegiance] turn = 0 -> (turn' = 1) & (allegiances' = 3);
 
  [vote_1] turn = 1 -> true;
  [elect_a_1] turn = 1 -> (turn' = 2);
  [elect_b_1] turn = 1 -> (turn' = 2);
  [elect_c_1] turn = 1 -> (turn' = 2);

  [vote_2] turn = 2 -> true;
  [elect_a_2] turn = 2 -> (turn' = 3);
  [elect_b_2] turn = 2 -> (turn' = 3);
  [elect_c_2] turn = 2 -> (turn' = 3);

  [vote_3] turn = 3 -> true;
  [elect_a_3] turn = 3 -> (turn' = 4);
  [elect_b_3] turn = 3 -> (turn' = 4);
  [elect_c_3] turn = 3 -> (turn' = 4);

  [vote_4] turn = 4 -> true;
  [elect_a_4] turn = 4 -> (turn' = 5);
  [elect_b_4] turn = 4 -> (turn' = 5);
  [elect_c_4] turn = 4 -> (turn' = 5);

  [vote_5] turn = 5 -> true;
  [elect_a_5] turn = 5 -> (turn' = 6);
  [elect_b_5] turn = 5 -> (turn' = 6);
  [elect_c_5] turn = 5 -> (turn' = 6);

  [vote_6] turn = 6 -> true;
  [elect_a_6] turn = 6 -> (turn' = 7);
  [elect_b_6] turn = 6 -> (turn' = 7);
  [elect_c_6] turn = 6 -> (turn' = 7);

endmodule

system
  voting_system || order_monitor || constit_1 || constit_2 || constit_3 || constit_4 || constit_5 || constit_6
endsystem
