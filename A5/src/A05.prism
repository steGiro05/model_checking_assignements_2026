mdp

// ---------------------------------------------------------------------------
// Electoral pacts (chosen by order_monitor before any vote)
// allegiances: 0 -> none, 1 -> ab, 2 -> ac, 3 -> bc
// In every constituency the weaker partner of the pact stands down: its probability
// goes to 0, a fraction T goes to the ally and the rest (1-T) to the third party.
// ---------------------------------------------------------------------------
const double T = 0.7; // share of the withdrawn party's votes transferred to the ally

// base probabilities per constituency (no pact): tune here, pc_i = 1 - pa_i - pb_i
const double pa_1 = 1/9; const double pb_1 = 1/9; const double pc_1 = 1 - pa_1 - pb_1;
const double pa_2 = 1/3; const double pb_2 = 1/3; const double pc_2 = 1 - pa_2 - pb_2;
const double pa_3 = 1/3; const double pb_3 = 1/3; const double pc_3 = 1 - pa_3 - pb_3;
const double pa_4 = 1/3; const double pb_4 = 1/3; const double pc_4 = 1 - pa_4 - pb_4;
const double pa_5 = 1/3; const double pb_5 = 1/3; const double pc_5 = 1 - pa_5 - pb_5;
const double pa_6 = 1/3; const double pb_6 = 1/3; const double pc_6 = 1 - pa_6 - pb_6;

// probabilities actually used by vote_i, depending on the pact
formula qa_1 = allegiances=1 ? (pa_1>=pb_1 ? pa_1+T*pb_1 : 0) : allegiances=2 ? (pa_1>=pc_1 ? pa_1+T*pc_1 : 0) : allegiances=3 ? (pb_1>=pc_1 ? pa_1+(1-T)*pc_1 : pa_1+(1-T)*pb_1) : pa_1;
formula qb_1 = allegiances=1 ? (pa_1>=pb_1 ? 0 : pb_1+T*pa_1) : allegiances=2 ? (pa_1>=pc_1 ? pb_1+(1-T)*pc_1 : pb_1+(1-T)*pa_1) : allegiances=3 ? (pb_1>=pc_1 ? pb_1+T*pc_1 : 0) : pb_1;
formula qc_1 = allegiances=1 ? (pa_1>=pb_1 ? pc_1+(1-T)*pb_1 : pc_1+(1-T)*pa_1) : allegiances=2 ? (pa_1>=pc_1 ? 0 : pc_1+T*pa_1) : allegiances=3 ? (pb_1>=pc_1 ? 0 : pc_1+T*pb_1) : pc_1;

formula qa_2 = allegiances=1 ? (pa_2>=pb_2 ? pa_2+T*pb_2 : 0) : allegiances=2 ? (pa_2>=pc_2 ? pa_2+T*pc_2 : 0) : allegiances=3 ? (pb_2>=pc_2 ? pa_2+(1-T)*pc_2 : pa_2+(1-T)*pb_2) : pa_2;
formula qb_2 = allegiances=1 ? (pa_2>=pb_2 ? 0 : pb_2+T*pa_2) : allegiances=2 ? (pa_2>=pc_2 ? pb_2+(1-T)*pc_2 : pb_2+(1-T)*pa_2) : allegiances=3 ? (pb_2>=pc_2 ? pb_2+T*pc_2 : 0) : pb_2;
formula qc_2 = allegiances=1 ? (pa_2>=pb_2 ? pc_2+(1-T)*pb_2 : pc_2+(1-T)*pa_2) : allegiances=2 ? (pa_2>=pc_2 ? 0 : pc_2+T*pa_2) : allegiances=3 ? (pb_2>=pc_2 ? 0 : pc_2+T*pb_2) : pc_2;

formula qa_3 = allegiances=1 ? (pa_3>=pb_3 ? pa_3+T*pb_3 : 0) : allegiances=2 ? (pa_3>=pc_3 ? pa_3+T*pc_3 : 0) : allegiances=3 ? (pb_3>=pc_3 ? pa_3+(1-T)*pc_3 : pa_3+(1-T)*pb_3) : pa_3;
formula qb_3 = allegiances=1 ? (pa_3>=pb_3 ? 0 : pb_3+T*pa_3) : allegiances=2 ? (pa_3>=pc_3 ? pb_3+(1-T)*pc_3 : pb_3+(1-T)*pa_3) : allegiances=3 ? (pb_3>=pc_3 ? pb_3+T*pc_3 : 0) : pb_3;
formula qc_3 = allegiances=1 ? (pa_3>=pb_3 ? pc_3+(1-T)*pb_3 : pc_3+(1-T)*pa_3) : allegiances=2 ? (pa_3>=pc_3 ? 0 : pc_3+T*pa_3) : allegiances=3 ? (pb_3>=pc_3 ? 0 : pc_3+T*pb_3) : pc_3;

formula qa_4 = allegiances=1 ? (pa_4>=pb_4 ? pa_4+T*pb_4 : 0) : allegiances=2 ? (pa_4>=pc_4 ? pa_4+T*pc_4 : 0) : allegiances=3 ? (pb_4>=pc_4 ? pa_4+(1-T)*pc_4 : pa_4+(1-T)*pb_4) : pa_4;
formula qb_4 = allegiances=1 ? (pa_4>=pb_4 ? 0 : pb_4+T*pa_4) : allegiances=2 ? (pa_4>=pc_4 ? pb_4+(1-T)*pc_4 : pb_4+(1-T)*pa_4) : allegiances=3 ? (pb_4>=pc_4 ? pb_4+T*pc_4 : 0) : pb_4;
formula qc_4 = allegiances=1 ? (pa_4>=pb_4 ? pc_4+(1-T)*pb_4 : pc_4+(1-T)*pa_4) : allegiances=2 ? (pa_4>=pc_4 ? 0 : pc_4+T*pa_4) : allegiances=3 ? (pb_4>=pc_4 ? 0 : pc_4+T*pb_4) : pc_4;

formula qa_5 = allegiances=1 ? (pa_5>=pb_5 ? pa_5+T*pb_5 : 0) : allegiances=2 ? (pa_5>=pc_5 ? pa_5+T*pc_5 : 0) : allegiances=3 ? (pb_5>=pc_5 ? pa_5+(1-T)*pc_5 : pa_5+(1-T)*pb_5) : pa_5;
formula qb_5 = allegiances=1 ? (pa_5>=pb_5 ? 0 : pb_5+T*pa_5) : allegiances=2 ? (pa_5>=pc_5 ? pb_5+(1-T)*pc_5 : pb_5+(1-T)*pa_5) : allegiances=3 ? (pb_5>=pc_5 ? pb_5+T*pc_5 : 0) : pb_5;
formula qc_5 = allegiances=1 ? (pa_5>=pb_5 ? pc_5+(1-T)*pb_5 : pc_5+(1-T)*pa_5) : allegiances=2 ? (pa_5>=pc_5 ? 0 : pc_5+T*pa_5) : allegiances=3 ? (pb_5>=pc_5 ? 0 : pc_5+T*pb_5) : pc_5;

formula qa_6 = allegiances=1 ? (pa_6>=pb_6 ? pa_6+T*pb_6 : 0) : allegiances=2 ? (pa_6>=pc_6 ? pa_6+T*pc_6 : 0) : allegiances=3 ? (pb_6>=pc_6 ? pa_6+(1-T)*pc_6 : pa_6+(1-T)*pb_6) : pa_6;
formula qb_6 = allegiances=1 ? (pa_6>=pb_6 ? 0 : pb_6+T*pa_6) : allegiances=2 ? (pa_6>=pc_6 ? pb_6+(1-T)*pc_6 : pb_6+(1-T)*pa_6) : allegiances=3 ? (pb_6>=pc_6 ? pb_6+T*pc_6 : 0) : pb_6;
formula qc_6 = allegiances=1 ? (pa_6>=pb_6 ? pc_6+(1-T)*pb_6 : pc_6+(1-T)*pa_6) : allegiances=2 ? (pa_6>=pc_6 ? 0 : pc_6+T*pa_6) : allegiances=3 ? (pb_6>=pc_6 ? 0 : pc_6+T*pb_6) : pc_6;

module constit_1
  selected_1 : [0..3] init 0; // Party selected by the constituency - 0 means no selection yet
  finished_1 : bool init false; // Decision made for the constituency
  
  // Select the winner party for the constituency - probabilities depend on the electoral pact (see qa_i, qb_i, qc_i)
  [vote_1] selected_1 = 0 ->
	qa_1: (selected_1' = 1)
	+ qb_1: (selected_1' = 2)
	+ qc_1: (selected_1' = 3);

  [elect_a_1] (selected_1 = 1 & finished_1 = false) -> (finished_1' = true);
  [elect_b_1] (selected_1 = 2 & finished_1 = false) -> (finished_1' = true);
  [elect_c_1] (selected_1 = 3 & finished_1 = false) -> (finished_1' = true);
endmodule

module constit_2
  selected_2 : [0..3] init 0; // Party selected by the constituency - 0 means no selection yet
  finished_2 : bool init false; // Decision made for the constituency
  
  // Select the winner party for the constituency - probabilities depend on the electoral pact (see qa_i, qb_i, qc_i)
  [vote_2] selected_2 = 0 ->
	qa_2: (selected_2' = 1)
	+ qb_2: (selected_2' = 2)
	+ qc_2: (selected_2' = 3);

  [elect_a_2] (selected_2 = 1 & finished_2 = false) -> (finished_2' = true);
  [elect_b_2] (selected_2 = 2 & finished_2 = false) -> (finished_2' = true);
  [elect_c_2] (selected_2 = 3 & finished_2 = false) -> (finished_2' = true);
endmodule

