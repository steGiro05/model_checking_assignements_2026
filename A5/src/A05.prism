  selected_3 : [0..3] init 0; // Party selected by the constituency - 0 means no selection yet
  finished_3 : bool init false; // Decision made for the constituency
  
  // Select the winner party for the constituency - probabilities depend on the electoral pact (see qa_i, qb_i, qc_i)
