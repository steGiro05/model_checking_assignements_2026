  [elect_c_3] (selected_3 = 3 & finished_3 = false) -> (finished_3' = true);
endmodule

module constit_4
  selected_4 : [0..3] init 0; // Party selected by the constituency - 0 means no selection yet
  finished_4 : bool init false; // Decision made for the constituency
  
  // Select the winner party for the constituency - probabilities depend on the electoral pact (see qa_i, qb_i, qc_i)
